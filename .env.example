# -----------------------------------------------------------------------------
# HackOps AI Environment Template
# Copy this file to .env.local and fill in your API keys & database credentials:
# -----------------------------------------------------------------------------

# Google Gemini AI API Key (Gemini 2.5 Flash)
GEMINI_API_KEY=your_google_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_google_gemini_api_key_here

# Groq High-Speed LLM API Key (Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Supabase PostgreSQL Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
